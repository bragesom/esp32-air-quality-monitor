# PlatformIO
.pio

# VS Code — machine-specific paths, regenerated by the PlatformIO extension
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# Local credentials (see src/secrets.example.h)
src/secrets.h

# Generated on every build by compress_web_files.py — never commit these,
# or each contributor's build produces spurious diffs.
data/www/*.gz

# Python / OS noise
__pycache__/
*.py[cod]
.DS_Store
Thumbs.db
